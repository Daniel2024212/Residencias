<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla temporal mostrada mientras se abre o crea la base de datos de autenticación.
    La lógica y los eventos permanecen en Java; este archivo declara recursos o presentación.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F1F6F8">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="28dp" android:gravity="center">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:paddingBottom="8dp" android:textSize="32sp" android:textColor="#181E34" android:text="Un momento"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="4dp" android:paddingBottom="8dp" android:textSize="14sp" android:textColor="#607380" android:text="Estamos preparando tu espacio."/>
        <ProgressBar android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
